:name eventra
:workspace backend

:runtimes
  :main_rs rust
  :main_py python; cargo python-installer-fallback
  :dua-cli cargo dua full,tokio-rt-thread
  :postgresql pacman postgresql; apt postgresql; dnf postgresql,psql

  :jupyter pip jupyter

:databases
  :main postgres
  :other redis
  :foo sqlite
:volumes
  :cache ram_fs max(10G)
:ports
  :frontend
  :backend 1234
  :foo engon.cm 1234
  :bar engon.cm


$ DATABASE_URL &databases.main
$ REDIS_URL &databases.cache
$ STORAGE_URL &volumes.storage

< $REQUIRED_ENV


.build safe(10)
  < &src !0
  < $REQUIRED_ENV_VAR
  ~ target
  # direct biding
  $ STORAGE_URL &volumes.cache
  # a interpolation into an environment variable
  # output = simple string here ... fof ..-is{escaped
  $ BACKEND_PORT {simple string} here {$STORAGE_URL} fof {&ports.backend}-is\{escaped
  $ BACKEND_PORT simple string here

  # from cach encrypted vault or something; env requried

  !nu -cli args here
    var foo = bar;
    foo = (bar | complete).stderr
