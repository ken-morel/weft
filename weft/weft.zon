.{
    .workspace = "weft",
    .modes = .{ "default", "pages" },
    .remotes = .{
        .local = .{ .groups = "local" },
    },
    .sources = .{
        .site = "site/",
    },
    .environments = .{
        .bun = .{
            .pkgs = .{
                "qkydg77xf2s395md9fq0a6djjpq7fzh4-bun-1.4.2",
            },
        },
    },
    .pipelines = .{
        .@"site-fetch" = .{
            .in = .{"-site"},
            .out = .{},
            .run = .{ .file = "site-build" },
            .keep = .{
                .@"web-modules" = "node_modules/",
            },
            .env = .{ .uses = .{"bun"} },
        },
        .@"site-test" = .{
            .in = .{"-site"},
            .out = .{},
            .keep = .{
                .@"web-modules" = "node_modules/",
            },
            .tune = .{
                .net = .{ .private = true },
            },
            .env = .{ .uses = .{"bun"} },
        },
        .@"site-build" = .{
            .in = .{"-site"},
            .keep = .{
                .@"web-modules" = "node_modules/",
            },
            .tune = .{
                .net = .{ .private = true },
            },
            .env = .{
                .uses = .{"bun"},
                .vars = .{
                    .@"pages:BASE_PATH" = "/weft",
                },
            },
        },
        .@"site-run" = .{
            .in = .{"site-build"},
            .out = .{},
            .sibling = .{ .then = .kill },
            .env = .{
                .uses = .{"bun"},
                .vars = .{
                    .PORT = "6080",
                },
            },
        },
    },
}
